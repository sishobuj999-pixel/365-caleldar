<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/widget_transparent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextClock android:id="@+id/widget_clock" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:format12Hour="hh:mm:ss a" android:format24Hour="HH:mm:ss"
            android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/widget_year" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="365"
            android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"/>
     <LinearLayout android:id="@+id/widget_shortcuts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="5dp" android:background="#18000000">
  <TextView android:id="@+id/widget_shortcut_date" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:text="▦ Date" android:textColor="#FFFFFFFF" android:textSize="10sp"/>
  <TextView android:id="@+id/widget_shortcut_weather" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:text="☀ Weather" android:textColor="#FFFFFFFF" android:textSize="10sp"/>
  <TextView android:id="@+id/widget_shortcut_time" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:text="◷ Time" android:textColor="#FFFFFFFF" android:textSize="10sp"/>
 </LinearLayout></LinearLayout>
    <TextClock android:id="@+id/widget_date" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:format12Hour="EEEE, d MMMM yyyy"
        android:format24Hour="EEEE, d MMMM yyyy" android:textColor="#DCE5E8" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_days" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="59" android:textColor="#FFFFFF"
            android:textSize="39sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.035"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=":" android:textColor="#FFFFFF" android:textSize="37sp"
            android:fontFamily="sans-serif-black"/>
        <TextView android:id="@+id/widget_hour_prefix" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF"
            android:textSize="37sp" android:fontFamily="sans-serif-black"/>
        <Chronometer android:id="@+id/widget_timer" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:gravity="center_vertical"
            android:textColor="#FFFFFF" android:textSize="37sp" android:textStyle="bold"
            android:fontFamily="sans-serif-black" android:format="%s"/>
    </LinearLayout>
</LinearLayout>