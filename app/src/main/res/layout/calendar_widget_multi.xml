<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/widget_glass">
 <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <TextClock android:id="@+id/widget_clock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:format12Hour="hh:mm:ss a" android:format24Hour="HH:mm:ss" android:textColor="#FFFFFFFF" android:textSize="21sp"/>
  <LinearLayout android:id="@+id/widget_weather_panel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end|center_vertical" android:paddingStart="8dp">
  <TextView android:id="@+id/widget_weather_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFFFF" android:textSize="25sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed"/>
  <TextView android:id="@+id/widget_weather_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weather" android:textColor="#DCE5E8" android:textSize="10sp" android:maxWidth="100dp" android:gravity="end"/>
 </LinearLayout>
 </LinearLayout>
 <TextClock android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="EEEE, d MMM yyyy" android:format24Hour="EEEE, d MMM yyyy" android:textColor="#DCE5E8" android:textSize="12sp"/>
 <LinearLayout android:id="@+id/widget_countdown_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:id="@+id/widget_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="58" android:textColor="#FFFFFFFF" android:textSize="31sp" android:fontFamily="sans-serif-black"/>
  <TextView android:id="@+id/widget_colon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FFFFFFFF" android:textSize="30sp"/>
  <Chronometer android:id="@+id/widget_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format="%s" android:textColor="#FFFFFFFF" android:textSize="25sp" android:textStyle="bold" android:fontFamily="sans-serif-black"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_progress_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/widget_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="83%" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold"/>
  <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100" android:progress="83" android:progressTint="#BDF7D8" android:progressBackgroundTint="#44FFFFFF"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_dayofyear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Day 307 of 365" android:textColor="#DCE5E8" android:textSize="11sp"/>
 <TextView android:id="@+id/widget_passed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="306 days passed" android:textColor="#DCE5E8" android:textSize="11sp"/>
 <TextView android:id="@+id/widget_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="58 days left" android:textColor="#DCE5E8" android:textSize="11sp"/>
 <TextView android:id="@+id/widget_daynum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#FFFFFFFF" android:textSize="48sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOVEMBER" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_week" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WEEK 45 · TUESDAY" android:textColor="#DCE5E8" android:textSize="11sp"/>
 </LinearLayout>