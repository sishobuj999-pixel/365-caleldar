<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/widget_water">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextClock android:id="@+id/widget_clock" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:format12Hour="hh:mm:ss a" android:format24Hour="HH:mm:ss"
            android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="sans-serif-medium"/>
        <LinearLayout android:id="@+id/widget_weather_panel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end|center_vertical" android:paddingStart="8dp">
  <TextView android:id="@+id/widget_weather_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFFFF" android:textSize="29sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed"/>
  <TextView android:id="@+id/widget_weather_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weather" android:textColor="#DCE5E8" android:textSize="12sp" android:maxWidth="120dp" android:gravity="end"/>
 </LinearLayout>
    </LinearLayout>
    <TextClock android:id="@+id/widget_date" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:format12Hour="EEEE, d MMMM yyyy"
        android:format24Hour="EEEE, d MMMM yyyy" android:textColor="#DCE5E8" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_days" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="59" android:textColor="#FFFFFF"
            android:textSize="39sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.035"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=":" android:textColor="#FFFFFF" android:textSize="37sp"
            android:fontFamily="sans-serif-black"/>
        <TextView android:id="@+id/widget_hour_prefix" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF"
            android:textSize="37sp" android:fontFamily="sans-serif-black"/>
        <Chronometer android:id="@+id/widget_timer" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:gravity="center_vertical"
            android:textColor="#FFFFFF" android:textSize="37sp" android:textStyle="bold"
            android:fontFamily="sans-serif-black" android:format="%s"/>
    </LinearLayout>
 </LinearLayout>